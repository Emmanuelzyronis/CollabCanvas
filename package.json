{
  "name": "collabcanvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Collaborative infinite canvas where a human and their AI agent work side-by-side via WebMCP.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "api": "tsx server/index.ts",
    "db:migrate": "tsx server/persistence/migrate.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mcp-b/global": "^5.1.0",
    "clsx": "^2.1.1",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
